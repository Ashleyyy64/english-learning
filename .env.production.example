# ===== Lingua 生产环境变量模板 =====
# 部署到 Ubuntu 服务器时，复制本文件为 .env 并按需修改。

# PostgreSQL 数据库连接串
# 用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://lingua:CHANGE_ME@localhost:5432/lingua?schema=public"

# JWT 签名密钥（务必替换为强随机字符串）
# 生成命令：openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# edge-tts 合成用的 Python 解释器（Ubuntu 服务器上为 python3）
PYTHON_BIN="python3"
