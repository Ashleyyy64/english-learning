# ===== Lingua 生产环境变量模板 =====
# 部署到 Ubuntu 服务器时，复制本文件为 .env 并按需修改。

# PostgreSQL 数据库连接串
# 用户名:密码@主机:端口/数据库名
DATABASE_URL="postgresql://lingua:CHANGE_ME@localhost:5432/lingua?schema=public"

# JWT 签名密钥（务必替换为强随机字符串）
# 生成命令：openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# 验证码哈希加盐（建议单独生成：openssl rand -base64 32）
CODES_PEPPER="replace-with-another-random-secret"

# OAuth 令牌加密密钥（建议单独生成：openssl rand -base64 32）
OAUTH_ENCRYPTION_KEY="replace-with-another-random-secret"

# 应用对外访问地址（OAuth 回调拼接用，务必替换为你的域名）
APP_BASE_URL="https://你的域名"

# ===== 邮件 SMTP（验证码邮件）=====
# 不配置则不会真正发送邮件，生产环境务必配置（如阿里云邮件推送/QQ邮箱 SMTP）
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_USER="noreply@你的域名"
SMTP_PASS="你的SMTP授权码"
SMTP_FROM="Lingua <noreply@你的域名>"

# ===== 短信（验证码短信）=====
# console=开发控制台兜底；tencent=腾讯云短信
SMS_PROVIDER="console"
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
# TENCENT_SMS_REGION="ap-guangzhou"

# ===== 第三方登录（OAuth，按需配置）=====
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_REDIRECT_URI="https://你的域名/api/auth/oauth/wechat/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="https://你的域名/api/auth/oauth/github/callback"

# edge-tts 合成用的 Python 解释器（Ubuntu 服务器上为 python3）
PYTHON_BIN="python3"
