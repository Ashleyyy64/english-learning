# PostgreSQL 数据库连接串（相对部署环境）
DATABASE_URL="postgresql://lingua:CHANGE_ME@localhost:5432/lingua?schema=public"

# JWT 签名密钥（生产环境务必替换为强随机字符串，openssl rand -base64 48 生成）
JWT_SECRET="replace-with-a-long-random-secret"

# 验证码哈希加盐（可选，缺省回退 JWT_SECRET；建议单独生成：openssl rand -base64 32）
CODES_PEPPER="replace-with-a-long-random-secret"

# OAuth 令牌加密密钥（可选，缺省回退 JWT_SECRET；建议单独生成：openssl rand -base64 32）
OAUTH_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# 应用对外访问的基础地址（用于 OAuth 回调拼接，生产必填）
# APP_BASE_URL="https://你的域名"

# ===== 邮件（SMTP，用于发送验证码邮件；不配置则开发环境回退到控制台打印） =====
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Lingua <noreply@你的域名>"

# ===== 短信（用于发送验证码短信；console=开发控制台兜底，tencent=腾讯云） =====
SMS_PROVIDER="console"
# 腾讯云短信（SMS_PROVIDER=tencent 时必填）
TENCENT_SMS_SECRET_ID=""
TENCENT_SMS_SECRET_KEY=""
TENCENT_SMS_SDK_APP_ID=""
TENCENT_SMS_SIGN_NAME=""
TENCENT_SMS_TEMPLATE_ID=""
# TENCENT_SMS_REGION="ap-guangzhou"

# ===== 第三方登录（OAuth）=====
# 微信开放平台「网站应用」扫码登录
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_REDIRECT_URI="https://你的域名/api/auth/oauth/wechat/callback"

# GitHub OAuth App（通用 OAuth2 示例）
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="https://你的域名/api/auth/oauth/github/callback"

# edge-tts 合成用的 Python 解释器（Ubuntu 服务器上用 python3）
PYTHON_BIN="python3"
